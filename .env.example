# GitHub App configuration — SERVER-SIDE ONLY. Never expose these values to
# the browser, never commit the real .env.local. See docs/GITHUB_APP_SETUP.md

# Numeric App ID from https://github.com/organizations/.../settings/apps/<slug>
# (or personal app: https://github.com/settings/apps/<slug>) — "App ID" field.
GITHUB_APP_ID=

# Slug from the App's public page URL: github.com/apps/<GITHUB_APP_SLUG>
GITHUB_APP_SLUG=

# Contents of the .pem private key you downloaded when creating the App.
# Either paste it with literal \n escapes:
GITHUB_APP_PRIVATE_KEY=
# ...or provide it base64-encoded instead:
# GITHUB_APP_PRIVATE_KEY_BASE64=

# Public origin of this deployment, used for post-install redirects.
# Locally use your tunnel URL (e.g. https://gityard.ngrok.app); on Vercel
# set it to your production URL (e.g. https://gityard.vercel.app).
APP_URL=

# Client-visible flag that switches the frontend from demo mode to live mode.
# With the backend in this same app, the default routes base is enough:
NEXT_PUBLIC_GITYARD_GITHUB_API=/api/github
